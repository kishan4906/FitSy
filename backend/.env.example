PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/fitsy
JWT_SECRET=supersecretjwtkey_replace_in_production

# Neural VTON on Modal — set after `modal deploy fitsy/vton-modal/app.py`.
# Leave empty to disable neural try-on (frontend falls back to geometric warp).
MODAL_VTON_URL=
MODAL_VTON_SECRET=

# AI Personal Stylist — get a free key at https://console.groq.com/keys.
# Leave empty and the /api/stylist/recommend endpoint returns a clear
# "AI stylist unavailable" error instead of crashing.
GROQ_API_KEY=
